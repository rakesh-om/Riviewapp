{%- comment -%}
  griddesign.liquid
  Theme App Extension block: Grid review cards that:
    - read appearance/settings from shop.metafields.riview.grid_settings.value
    - fetch review data from an API (configured here as http://localhost:5000/api/reviews)
    - render a responsive grid (unique classes prefixed with "gr-")
    - honors metafield: desktop_cards, star_color, card_bg_color, card_text_color,
      border_color, button_bg_color, button_text_color
{%- endcomment -%}

{%- assign raw_settings = shop.metafields.riview.grid_settings.value | default: '{}' -%}
{%- assign gs = raw_settings | parse_json -%}

{%- assign desktop_cards = gs.desktop_cards | default: 4 | times: 1 -%}
{%- assign star_color = gs.star_color | default: '#FBBF24' -%}
{%- assign card_bg = gs.card_bg_color | default: '#ffffff' -%}
{%- assign card_text = gs.card_text_color | default: '#111827' -%}
{%- assign border_color = gs.border_color | default: 'rgba(0,0,0,0.06)' -%}
{%- assign button_bg = gs.button_bg_color | default: '#0066cc' -%}
{%- assign button_text = gs.button_text_color | default: '#ffffff' -%}

<style>
/* GRID widget - unique gr- prefixed classes */
.gr-grid-widget {
  --gr-card-bg: {{ card_bg }};
  --gr-card-text: {{ card_text }};
  --gr-star-color: {{ star_color }};
  --gr-border-color: {{ border_color }};
  --gr-button-bg: {{ button_bg }};
  --gr-button-text: {{ button_text }};
  padding: 12px;
  box-sizing: border-box;
}

.gr-grid-inner {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(1, 1fr);
}

/* responsive columns */
@media (min-width: 640px) {
  .gr-grid-inner { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .gr-grid-inner { grid-template-columns: repeat({{ desktop_cards }}, 1fr); }
}

.gr-card {
  background: var(--gr-card-bg);
  color: var(--gr-card-text);
  border: 1px solid var(--gr-border-color);
  border-radius: 12px;
  padding: 14px;
  min-height: 160px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  box-shadow: 0 6px 18px rgba(0,0,0,0.05);
}

.gr-card-header {
  display:flex;
  gap:12px;
  align-items:center;
}
.gr-avatar {
  width:48px;
  height:48px;
  border-radius:50%;
  object-fit:cover;
  background:#eee;
  flex-shrink:0;
}
.gr-name { font-weight:700; font-size:14px; }
.gr-stars { display:flex; gap:6px; align-items:center; color: var(--gr-star-color); }

/* comment text */
.gr-comment { margin-top:10px; font-size:14px; line-height:1.4; color: var(--gr-card-text); }

/* thumbs row */
.gr-img-row { display:flex; gap:8px; margin-top:12px; }
.gr-thumb { width:68px; height:52px; object-fit:cover; border-radius:8px; cursor:pointer; }

/* show more button */
.gr-btn-row { margin-top:18px; text-align:center; }
.gr-show-btn {
  display:inline-block;
  padding:10px 18px;
  border-radius:8px;
  background: var(--gr-button-bg);
  color: var(--gr-button-text);
  border: none;
  cursor: pointer;
  font-weight:700;
}
.gr-show-btn-outline {
  display:inline-block;
  padding:10px 16px;
  border-radius:8px;
  background: transparent;
  color: var(--gr-button-bg);
  border: 2px solid var(--gr-button-bg);
  cursor: pointer;
  font-weight:700;
}

/* small helpers */
.gr-empty { padding: 12px; color:#666; text-align:center; }
</style>

<div class="gr-grid-widget" aria-label="Grid reviews" data-api-url="http://localhost:5000/api/reviews">
  <div class="gr-header">
    <h3 style="margin:0 0 8px 0; font-size:16px; color: {{ card_text }};">Customer Reviews — Grid</h3>
  </div>

  <div class="gr-grid-inner" data-grid></div>

  <div class="gr-btn-row" data-btn-row style="display:block;">
    <!-- button populated by JS -->
  </div>
</div>

<script>
(function () {
  const root = document.currentScript.previousElementSibling; // .gr-grid-widget
  if (!root) return;
  const API_URL = root.getAttribute('data-api-url') || '/api/reviews';
  const grid = root.querySelector('[data-grid]');
  const btnRow = root.querySelector('[data-btn-row]');

  // Settings read from Liquid (inlined styles/vars are already set). We'll keep JS-logic independent.
  let reviews = [];
  let visibleCount = 4;
  const INCREMENT = 4; // load 4 more on each click

  function escapeHtml(str) {
    if (typeof str !== 'string') return '';
    return str.replace(/[&<>"']/g, function(m){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]); });
  }

  function renderStarHtml(rating) {
    const full = Number(rating) || 0;
    let out = '';
    for (let i = 1; i <= 5; i++) {
      if (i <= full) out += '<span aria-hidden="true" style="color:var(--gr-star-color)">★</span>';
      else out += '<span aria-hidden="true" style="color:#e6e6e6">★</span>';
    }
    return out;
  }

  function createCard(r, idx) {
    const wrapper = document.createElement('article');
    wrapper.className = 'gr-card';
    wrapper.setAttribute('role', 'article');
    wrapper.innerHTML = `
      <div>
        <div class="gr-card-header">
          <img class="gr-avatar" src="${escapeHtml(r.profileImage || '')}" alt="${escapeHtml(r.name || 'Customer')}" />
          <div style="min-width:0">
            <div style="display:flex;align-items:center;gap:8px;">
              <div class="gr-stars" aria-hidden="true">${renderStarHtml(r.rating)}</div>
              <div style="font-size:13px;"><strong>${escapeHtml(r.name || '')}</strong></div>
            </div>
            <div style="font-size:11px;color:rgba(0,0,0,0.55);">${escapeHtml(r.date || '')}</div>
          </div>
        </div>

        <div class="gr-comment">${escapeHtml(r.comment || '')}</div>
      </div>

      <div class="gr-footer">
        ${ (Array.isArray(r.images) && r.images.length) ? ('<div class="gr-img-row">' + r.images.slice(0,3).map(src => `<img src="${escapeHtml(src)}" class="gr-thumb" alt="review image">`).join('') + '</div>') : '' }
      </div>
    `;
    return wrapper;
  }

  function renderGrid() {
    grid.innerHTML = '';
    if (!reviews.length) {
      const empty = document.createElement('div');
      empty.className = 'gr-empty';
      empty.textContent = 'No reviews available';
      grid.appendChild(empty);
      renderButton();
      return;
    }

    const slice = reviews.slice(0, visibleCount);
    slice.forEach((r, i) => {
      const card = createCard(r, i);
      grid.appendChild(card);
    });

    renderButton();
  }

  function renderButton() {
    btnRow.innerHTML = '';
    if (!reviews.length) return;
    if (visibleCount < reviews.length) {
      const btn = document.createElement('button');
      btn.className = 'gr-show-btn';
      btn.type = 'button';
      btn.textContent = 'Show more';
      btn.addEventListener('click', () => {
        visibleCount = Math.min(reviews.length, visibleCount + INCREMENT);
        renderGrid();
        // smooth scroll to newly loaded area (optional)
        const lastCard = grid.children[Math.min(visibleCount - 1, grid.children.length - 1)];
        if (lastCard) lastCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      btnRow.appendChild(btn);
    } else if (reviews.length > 4) {
      const btn = document.createElement('button');
      btn.className = 'gr-show-btn-outline';
      btn.type = 'button';
      btn.textContent = 'Show less';
      btn.addEventListener('click', () => {
        visibleCount = 4;
        renderGrid();
        window.scrollTo({ top: root.getBoundingClientRect().top + window.pageYOffset - 20, behavior: 'smooth' });
      });
      btnRow.appendChild(btn);
    }
  }

  async function loadReviews() {
    grid.innerHTML = '<div class="gr-empty">Loading reviews…</div>';
    try {
      const resp = await fetch(API_URL, { credentials: 'omit' });
      if (!resp.ok) throw new Error('Network response not ok: ' + resp.status);
      const payload = await resp.json();
      reviews = Array.isArray(payload?.reviews) ? payload.reviews : [];
      // ensure consistent fields (name, profileImage, rating, comment, date, images)
      reviews = reviews.map(r => ({
        name: r.name || r.title || '',
        profileImage: r.profileImage || r.avatar || '',
        rating: typeof r.rating !== 'undefined' ? r.rating : (r.rate || 0),
        comment: r.comment || r.text || r.body || '',
        date: r.date || r.createdAt || '',
        images: Array.isArray(r.images) ? r.images : []
      }));
      visibleCount = Math.min(4, reviews.length);
      renderGrid();
    } catch (err) {
      console.error('GR: failed to load reviews', err);
      grid.innerHTML = '<div class="gr-empty">Could not load reviews.</div>';
      renderButton();
    }
  }

  // initialize
  loadReviews();

})();
</script>

{%- schema -%}
{
  "name": "Grid Reviewse",
  "target": "section",
  "settings": []
}
{%- endschema -%}
